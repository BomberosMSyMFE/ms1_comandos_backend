# Entorno del microservicio
PORT=3000
NODE_ENV=development

# Configuración Amazon DynamoDB (Desarrollo local con amazon/dynamodb-local)
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=fakeLocalKeyId
AWS_SECRET_ACCESS_KEY=fakeLocalAccessKey

# Seguridad y Autenticación SSO
